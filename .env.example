# Copy this file to .env and fill in what you have. Every value here is optional -
# the app works fully on local data + Open-Meteo/GBIF/iNaturalist/Wikipedia
# (all free, no key needed) even if you set nothing at all.

SECRET_KEY=change-me-in-production

# Optional: get a free key at https://perenual.com/docs/api (free tier: ~100 req/day)
PERENUAL_API_KEY=

# Optional: get a free token at https://trefle.io (currently unreliable, best-effort only)
TREFLE_TOKEN=

# Optional: free Hugging Face token for the AI plant-doctor answers on /troubleshoot.
# Create a fine-grained token with the "Make calls to Inference Providers"
# permission at https://hf.co/settings/tokens (free tier — no paid plan needed).
HUGGINGFACE_API_TOKEN=

# Optional: which chat model the AI answers use. Any model from
# https://huggingface.co/models?inference_provider=all&other=conversational
# If the router reports a model has no provider, other widely-served
# models are tried automatically.
# HF_MODEL=Qwen/Qwen2.5-7B-Instruct

# Optional: protects the plant-submission review endpoints (/api/submissions).
# Send it as an X-Admin-Token header. Leave empty in local dev to keep them open.
ADMIN_TOKEN=

# How long external API responses stay cached, in seconds (default 24h).
# Volatile sources (weather, air quality) use shorter per-source TTLs defined
# in config.py; this value is only the fallback for everything else.
API_CACHE_TTL_SECONDS=86400
